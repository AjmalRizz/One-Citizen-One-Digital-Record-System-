# Server
PORT=5000
NODE_ENV=development
# Browser opened on start: auto | chrome | avast | edge
PREFERRED_BROWSER=auto

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ocodr_db

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
OTP_EXPIRY_MINUTES=5

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (optional). Leave SMTP_USER / SMTP_PASS empty and OTP codes print in the server console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="OCODR Digital Identity" <noreply@ocodr.gov.lk>
